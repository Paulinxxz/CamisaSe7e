
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>

    <header>
        <h1>CamisaSe7e</h1>
        <p>Catálogo de camisas de futebol</p>
    </header>

    <main>
        <h2>Cadastrar nova camisa</h2>

        <form action="/itens" method="POST">
            <label>Nome da camisa</label>
            <input type="text" name="nome" placeholder="Ex: Camisa Home 2026" required>

            <label>Time</label>
            <input type="text" name="time" placeholder="Ex: Real Madrid" required>

            <label>Tamanho</label>
            <input type="text" name="tamanho" placeholder="Ex: M, G ou GG" required>

            <label>Preço</label>
            <input type="number" name="preco" step="0.01" placeholder="Ex: 199.90" required>

            <label>Estoque</label>
            <input type="number" name="estoque" placeholder="Ex: 10" required>

            <button type="submit">Cadastrar camisa</button>
        </form>

        <h2>Camisas cadastradas</h2>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Time</th>
                    <th>Tamanho</th>
                    <th>Preço</th>
                    <th>Estoque</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                <% camisas.forEach(function(camisa) { %>
                    <tr>
                        <td><%= camisa.id %></td>
                        <td><%= camisa.nome %></td>
                        <td><%= camisa.time %></td>
                        <td><%= camisa.tamanho %></td>
                        <td>R$ <%= Number(camisa.preco).toFixed(2) %></td>
                        <td><%= camisa.estoque %></td>
                        <td>
                            <div class="acoes">
                                <a href="/editar/<%= camisa.id %>" class="btn-editar">Editar</a>

                                <form action="/excluir/<%= camisa.id %>" method="POST" onsubmit="return confirm('Tem certeza que deseja excluir esta camisa?')">
                                    <button type="submit" class="btn-excluir">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </main>

</body>
</html>