<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>

    <header>
        <h1>CamisaSe7e</h1>
        <p>Catálogo de Camisas de Futebol</p>
    </header>

    <main>

        <section class="cadastro">
            <h2>Cadastrar nova camisa</h2>

            <form action="/itens" method="POST">

                <label>Nome da camisa:</label>
                <input type="text" name="nome" placeholder="Ex: Camisa Home 2026" required>

                <label>Time:</label>
                <input type="text" name="time" placeholder="Ex: Real Madrid" required>

                <label>Tamanho:</label>
                <select name="tamanho" required>
                    <option value="">Selecione</option>
                    <option value="P">P</option>
                    <option value="M">M</option>
                    <option value="G">G</option>
                    <option value="GG">GG</option>
                </select>
                <input type="text" name="tamanho" placeholder="Ex: M, G ou GG" required>

                <label>Preço:</label>
                <input type="number" name="preco" step="0.01" placeholder="Ex: 199.90" required>

                <label>Estoque:</label>
                <input type="number" name="estoque" placeholder="Ex: 10" required>

                <button type="submit">Cadastrar camisa</button>

            </form>
        </section>

        <h2>Camisas disponíveis</h2>

        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nome</th>
                    <th>Time</th>
                    <th>Tamanho</th>
                    <th>Preço</th>
                    <th>Estoque</th>
                </tr>
            </thead>

            <tbody>
                <% camisas.forEach(function(camisa) { %>
                    <tr>
                        <td>
                            <%= camisa.id %>
                        </td>
                        <td>
                            <%= camisa.nome %>
                        </td>
                        <td>
                            <%= camisa.time %>
                        </td>
                        <td>
                            <%= camisa.tamanho %>
                        </td>
                        <td>R$ <%= Number(camisa.preco).toFixed(2).replace('.', ',' ) %>
                        </td>
                        <td>
                            <%= camisa.estoque %>
                        </td>
                    </tr>
                    <% }); %>
            </tbody>
        </table>
    </main>

</body>

</html>